{
  "name": "agent-market",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "eslint .",
    "lint:verify-rules": "node scripts/verify-eslint-rules.mjs",
    "format:check": "prettier --check .",
    "env:start": "node scripts/local-env/start.mjs",
    "env:stop": "node scripts/local-env/stop.mjs",
    "env:status": "node scripts/local-env/status.mjs",
    "env:test": "AGENT_MARKET_TEST_LOCAL_ENV_DIR=\"$(mktemp -d \"${TMPDIR:-/tmp}/agent-market-env-test.XXXXXX\")\" node --test scripts/local-env/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3",
    "typescript-eslint": "^8",
    "pg": "^8.12.0",
    "viem": "^2.19.0",
    "zod": "^3.23.8"
  }
}
