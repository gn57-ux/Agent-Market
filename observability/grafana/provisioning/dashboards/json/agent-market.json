{
  "title": "Agent Market",
  "uid": "agent-market-overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "任务发布量 (tasks_published_total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "tasks_published_total", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "匹配延迟 p95 (dispatch_match_duration_seconds)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dispatch_match_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "结算成功率 (settlement_outcome_total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(settlement_outcome_total{outcome=\"success\"}) / sum(settlement_outcome_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "队列积压 (outbox_queue_backlog)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "outbox_queue_backlog", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "索引进度 (indexer_scan_checkpoint_block)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "indexer_scan_checkpoint_block", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "API target up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "up{job=\"agent-market-api\"}", "refId": "A" }]
    }
  ]
}
