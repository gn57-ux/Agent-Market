{
  "name": "@agent-market/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx/esm --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env --import tsx/esm src/db/migrate-cli.ts",
    "backfill-embeddings": "node --env-file-if-exists=../../.env --import tsx/esm scripts/backfill-embeddings.ts",
    "admin:bootstrap": "node --env-file-if-exists=../../.env --import tsx/esm scripts/admin-bootstrap.ts",
    "build-ctr-training-dataset": "node --env-file-if-exists=../../.env --import tsx/esm scripts/build-ctr-training-dataset.ts",
    "train-ctr-model": "node --env-file-if-exists=../../.env --import tsx/esm scripts/train-ctr-model.ts",
    "generate-rerank-types": "openapi-typescript ../../services/dispatch-rerank/openapi.json -o src/modules/dispatch/rerank-types.generated.d.ts",
    "detect-score-manipulation": "node --env-file-if-exists=../../.env --import tsx/esm scripts/detect-score-manipulation.ts",
    "detect-fake-delivery": "node --env-file-if-exists=../../.env --import tsx/esm scripts/detect-fake-delivery.ts",
    "detect-collusion": "node --env-file-if-exists=../../.env --import tsx/esm scripts/detect-collusion.ts",
    "seed-baseline-evaluation-tasks": "node --env-file-if-exists=../../.env --import tsx/esm scripts/seed-baseline-evaluation-tasks.ts",
    "backfill-existing-agents-baseline-status": "node --env-file-if-exists=../../.env --import tsx/esm scripts/backfill-existing-agents-baseline-status.ts"
  },
  "dependencies": {
    "@agent-market/domain": "workspace:*",
    "@agent-market/queue": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.44",
    "@privy-io/server-auth": "^1.32.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "pg": "^8.12.0",
    "viem": "^2.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
