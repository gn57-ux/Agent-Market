# Agent Market — 环境变量清单（示例值，不含真实密钥）
# 各模块通过自己的 .env（已被 .gitignore 忽略）加载所需变量。

# ---------- apps/api (Fastify) ----------
API_PORT=3001
DATABASE_URL=postgres://agent_market:changeme@localhost:5432/agent_market
SESSION_SECRET=replace-with-a-random-secret
# 独立 RPC：后端交易复核专用，与前端钱包使用的 RPC 提供方相互隔离（PRD §8.2）
BACKEND_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
TASK_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
YD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
YD_FAUCET_ADDRESS=0x0000000000000000000000000000000000000000
# 接单授权（EIP-712）签发密钥，平台服务端专用，与用户钱包私钥无关
ACCEPTANCE_PERMIT_SIGNER_KEY=replace-with-a-random-key

# ---------- apps/web (Vite，需以 VITE_ 前缀暴露给浏览器) ----------
VITE_API_BASE_URL=http://localhost:3001
VITE_CHAIN_ID=31337
VITE_WALLET_RPC_URL=http://127.0.0.1:8545
VITE_DISPATCH_API_BASE_URL=http://localhost:8081
# 合约地址：与 apps/api 使用相同的部署产物，仅通过 VITE_ 前缀重复声明以便前端读取
# YD 余额（Feature 4 T-401 WalletProvider 需要 VITE_YD_TOKEN_ADDRESS）
VITE_TASK_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_YD_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_YD_FAUCET_ADDRESS=0x0000000000000000000000000000000000000000

# ---------- services/dispatch (Go) ----------
DISPATCH_PORT=8081
ALGORITHM_VERSION=v0.1

# ---------- contracts (Hardhat 部署) ----------
DEPLOYER_PRIVATE_KEY=replace-with-a-random-testnet-only-key
DEPLOY_RPC_URL=http://127.0.0.1:8545
ARBITRATOR_ADDRESS=0x0000000000000000000000000000000000000000
